public class Car {
    public static String companyName="Moha car rental";
    public static int totalCars=0;
    private String plateNumber;
    private String carModel;
    private double dailyRate;
    private boolean rent;

    Car(){
        plateNumber= "Ab123";
       carModel="unknown";
       dailyRate= 0.0;
       rent=false;
       totalCars++;
    }

    Car(String plateNumber, String model, double dailyRate, boolean rent ){
        this.plateNumber=plateNumber;
        this.carModel=model;
        if (dailyRate<0){
        this.dailyRate=0.0;
        } else {
            this.dailyRate=dailyRate;
        }
        this.rent=false;
        totalCars++;
    }

    public String getPlateNumber(String s){
        return plateNumber;
    }
    public String getModel(){
        return carModel;
    }
    public double getDailyRate(){
        return dailyRate;
    }
    public boolean isRented(){
        return rent;
    }

    public void setPlateNumber(String plateNumber){
        this.plateNumber=plateNumber;

    }
    public void setCarModel(String carModel){
        this.carModel=carModel;

    }

    public void setDailyRate(double rate){
        if (dailyRate<0){
            System.out.println("Daily rate can not be negative");
        } else {
        this.dailyRate=rate;}
    }

    public void setRent(boolean rent){
        this.rent=rent;
    }

    public void rent(){
        if (rent){
        System.out.println("car is already rented");}
        else {rent=true;
            System.out.println("car is rented succsessfully");}
    }

    public void returnCar(){
        rent=false;
        System.out.println("car returned succsessfully");

    }


    public void displayInfo(){
        System.out.println("==== Car Info=====");
        System.out.println("Company name: "+ companyName);
        System.out.println("Total Cars: "+ totalCars);
        System.out.println("Plate number : "+ plateNumber);
        System.out.println("Car model : "+ carModel);
        System.out.println("Daily rate  : "+ dailyRate);
        System.out.println("Rent status: " +rent);


    }

   public static void displayCompanyName(){
       System.out.println("Company name: "+companyName);

   }
   public static void displayTotalCars(){
       System.out.println("Total cars :"+totalCars);
   }
}
